{
  "name": "nexora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --platform=node --format=esm --target=node22 --bundle --packages=external --outfile=dist/server.js",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --platform=node --format=esm --target=node22 --bundle --packages=external --outfile=dist/server.js",
    "preview": "vite preview",
    "start": "node dist/server.js",
    "test:backend": "tsx test/backend.test.ts",
    "test:audit": "tsx test/audit_verification.ts",
    "test:persistence": "tsx test/persistence_verification.ts",
    "test:remediation": "tsx test/remediation_verification.ts",
    "test:sprint": "tsx test/final_remediation_suite.ts",
    "test:phase32": "tsx test/phase3_2_persistence.test.ts",
    "test:phase33": "tsx test/phase3_3_postgres_integration.test.ts",
    "db:migrate": "tsx db/migrate.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}

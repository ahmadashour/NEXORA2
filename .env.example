# ==============================================================================
# NEXORA Platform — Environment Configuration Template
# Target: Hostinger Business Web Hosting / Supabase PostgreSQL (Phase 3.1.5B)
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# Target Hostinger Subdomain
NEXORA_DOMAIN=https://nexora.ashouracademy.com
CORS_ORIGIN=https://nexora.ashouracademy.com,http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Connection (Supavisor Transaction Pooler on Port 6543)
# ------------------------------------------------------------------------------
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Example: postgresql://postgres.abcdefghijklm:YourStrongPassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
DB_POOL_MAX=10
DB_SSL_REJECT_UNAUTHORIZED=false

# Authentication & Security
# WARNING: In production (NODE_ENV=production), JWT_SECRET MUST be set to a secure 64+ char secret string.
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_in_production
JWT_EXPIRES_IN=7d

# Rate Limiting
AUTH_RATE_LIMIT_MAX=40
AUTH_RATE_LIMIT_WINDOW_MS=600000

# Client Configuration (Vite)
VITE_API_URL=/api/v1
DISABLE_HMR=true

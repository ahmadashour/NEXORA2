# ==============================================================================
# NEXORA Platform — Environment Configuration Template
# Target: Hostinger Business Web Hosting / Supabase PostgreSQL (Phase 3.1.5B)
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# Target Hostinger Subdomain & CORS Allowed Origins
NEXORA_DOMAIN=https://nexora.ashouracademy.com
CORS_ORIGIN=https://nexora.ashouracademy.com,http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Connection (Supavisor Transaction Pooler on Port 6543)
# ------------------------------------------------------------------------------
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Example: postgresql://postgres.abcdefghijklm:YourStrongPassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
DB_POOL_MAX=10

# TLS / SSL Certificate Verification for PostgreSQL
# In production (NODE_ENV=production), strict certificate verification (rejectUnauthorized: true) is enforced.
# Provide DB_SSL_CA (raw PEM content) or DB_SSL_CA_PATH (file path) for full Root CA verification.
DB_SSL=true
DB_SSL_CA=
DB_SSL_CA_PATH=
DB_SSL_REJECT_UNAUTHORIZED=true

# ------------------------------------------------------------------------------
# Authentication & Session Security (Phase F Hardening)
# ------------------------------------------------------------------------------
# In production, JWT_SECRET MUST be set to a strong custom secret (min 32 characters, recommended 64+ hex).
# Server startup will abort immediately if the secret is weak, default, or missing in production.
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_in_production
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Rate Limiting & Storage Strategy
# ------------------------------------------------------------------------------
# Architecture Note for Hostinger Web App:
# In Hostinger's single-process container, in-memory sliding-window rate limiting provides
# sub-millisecond overhead and protects PostgreSQL connection limits from excessive pool usage.
# Multi-node / cluster deployments should point RATE_LIMIT_STORAGE to a distributed backend.
RATE_LIMIT_STORAGE=memory
AUTH_RATE_LIMIT_MAX=40
AUTH_RATE_LIMIT_WINDOW_MS=600000

# ------------------------------------------------------------------------------
# Client Configuration (React SPA / Vite)
# ------------------------------------------------------------------------------
VITE_API_URL=/api/v1
DISABLE_HMR=true
